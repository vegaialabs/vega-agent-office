{
  "name": "vega-agent-office",
  "version": "0.6.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && npm run typecheck && npm run build",
    "test:e2e": "playwright test",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:auth": "node tests/integration/auth.mjs",
    "test:captcha": "playwright test --config playwright.captcha.config.ts && CAPTCHA_MISSING=yes playwright test --config playwright.captcha.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "supabase": "3.3.0",
    "typescript": "^5.9.0"
  }
}
